{
  "name": "search-system",
  "version": "1.0.0",
  "description": "A modular search engine system built with TypeScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "tsx src/scripts/check-database.ts",
    "db:migrate:plan": "tsx src/scripts/migrate-database.ts plan",
    "db:migrate:up": "tsx src/scripts/migrate-database.ts up",
    "db:migrate:down": "tsx src/scripts/migrate-database.ts down",
    "db:check-access": "tsx src/scripts/check-database-access.ts",
    "db:check-metadata": "tsx src/scripts/check-metadata.ts",
    "db:check-categories": "tsx src/scripts/check-categories.ts",
    "db:check-filters": "tsx src/scripts/check-filters.ts",
    "db:check-selector-ids": "tsx src/scripts/check-selector-ids.ts",
    "db:check-keyword": "tsx src/scripts/check-keyword-search.ts",
    "db:check-catalog": "tsx src/scripts/check-catalog-repository.ts"
  },
  "keywords": [
    "search-engine"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "pg": "8.23.1"
  }
}
