{
  "name": "search-system",
  "version": "1.0.0",
  "description": "A modular search engine system built with TypeScript.",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "test": "node --import tsx --test tests/*.test.ts",
    "db:check": "tsx src/scripts/check-database.ts",
    "db:migrate:plan": "tsx src/scripts/migrate-database.ts plan",
    "db:migrate:up": "tsx src/scripts/migrate-database.ts up",
    "db:migrate:down": "tsx src/scripts/migrate-database.ts down",
    "db:check-access": "tsx src/scripts/check-database-access.ts",
    "db:check-metadata": "tsx src/scripts/check-metadata.ts",
    "db:check-categories": "tsx src/scripts/check-categories.ts",
    "db:check-filters": "tsx src/scripts/check-filters.ts",
    "db:check-selector-ids": "tsx src/scripts/check-selector-ids.ts",
    "db:check-keyword": "tsx src/scripts/check-keyword-search.ts",
    "db:check-catalog": "tsx src/scripts/check-catalog-repository.ts",
    "api:configure": "tsx src/scripts/configure-tool-api.ts",
    "api:check": "tsx src/scripts/check-tool-api.ts",
    "embedding:check": "node --import tsx src/scripts/check-embedding-provider.ts",
    "embedding:serve": "bash scripts/start-embedding-server.sh",
    "embedding:serve:remote": "bash scripts/start-embedding-remote.sh",
    "embedding:tunnel": "bash scripts/tunnel-embedding.sh",
    "db:check-embedding-storage": "node --import tsx src/scripts/check-embedding-storage.ts",
    "db:check-embedding-worker": "node --import tsx src/scripts/check-embedding-worker.ts",
    "test:embedding-storage:native": "EMBEDDING_STORAGE_TEST_MODE=native node --import tsx --test tests/embedding-storage.test.ts",
    "embedding:register": "node --import tsx src/scripts/register-embedding-model.ts",
    "embedding:backfill": "node --import tsx src/scripts/backfill-embeddings.ts",
    "db:check-category-semantic": "node --import tsx src/scripts/check-category-semantic.ts",
    "dev:semantic": "node --env-file=.env --env-file=.env.embedding.local --env-file=.env.category-semantic.local --env-file-if-exists=.env.query-cache.local --import tsx src/server.ts",
    "dev:hybrid": "node --env-file=.env --env-file=.env.embedding.local --env-file=.env.category-semantic.local --env-file=.env.product-hybrid.local --env-file-if-exists=.env.query-cache.local --import tsx src/server.ts",
    "db:check-product-hybrid": "node --import tsx src/scripts/check-product-hybrid.ts",
    "search:evaluate": "node --import tsx src/scripts/evaluate-search.ts",
    "search:benchmark": "node --import tsx src/scripts/benchmark-search.ts",
    "db:inspect-search": "node --import tsx src/scripts/inspect-search-performance.ts",
    "server:configure": "node --import tsx src/scripts/configure-server.ts",
    "server:check": "node dist/scripts/check-server-startup.js",
    "server:start": "node dist/scripts/start-server-release.js",
    "server:units": "node dist/scripts/render-server-units.js",
    "release:pack": "bash scripts/package-search-release.sh",
    "api:peer-check": "node dist/scripts/check-peer-api.js",
    "api:export": "node --import tsx src/scripts/export-tool-openapi.ts"
  },
  "keywords": [
    "search-engine"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-pgvector": "0.0.9",
    "@types/node": "^26.6.2",
    "@types/pg": "8.23.1",
    "node-pg-migrate": "9.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "dotenv": "^18.0.3",
    "fastify": "^5.12.5",
    "pg": "8.23.1"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
