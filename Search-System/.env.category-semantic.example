# Copy to ignored .env.category-semantic.local. Also load the existing private embedding profile.
SEARCH_CATEGORY_SEMANTIC_ENABLED=true
SEARCH_CATEGORY_SEMANTIC_MODEL_ID=EM0001
# Default: rank suggestions and ask for confirmation; do not guess thresholds.
SEARCH_CATEGORY_SEMANTIC_AUTO_SELECT=false
# Only enable automatic semantic choice after measuring on this model/catalog and recording a calibration:
# SEARCH_CATEGORY_SEMANTIC_MIN_SCORE=
# SEARCH_CATEGORY_SEMANTIC_MIN_GAP=
# SEARCH_CATEGORY_SEMANTIC_CALIBRATION_ID=
