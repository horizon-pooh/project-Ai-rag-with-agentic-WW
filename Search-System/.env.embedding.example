# Qwen3 model already running on BPLUTONIX. Mac uses SSH tunnel18081->server8081.
EMBEDDING_PROVIDER=llama_cpp
EMBEDDING_BASE_URL=http://127.0.0.1:18081/v1
# On the server itself use http://127.0.0.1:8081/v1 instead.
EMBEDDING_MODEL=/home/antonius/ai/models/Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_ARTIFACT=Qwen3-Embedding-0.6B-Q8_0.gguf
EMBEDDING_RUNTIME_VERSION=b11753-d8d92973c
EMBEDDING_DIMENSIONS=1024
EMBEDDING_CONTEXT_TOKENS=2048
EMBEDDING_DISTANCE_METRIC=cosine
EMBEDDING_POOLING=last
EMBEDDING_NORMALIZATION=server_l2
EMBEDDING_CONFIG_VERSION=qwen3-06b-q8-v1
EMBEDDING_QUERY_PREFIX_JSON='"Instruct: Given a product search query, retrieve relevant product descriptions\nQuery:"'
EMBEDDING_DOCUMENT_PREFIX_JSON='""'
# Optional only if llama-server is later started with --api-key. No OpenRouter key.
LLAMA_EMBEDDING_API_KEY=
EMBEDDING_MAX_ATTEMPTS=3
EMBEDDING_ATTEMPT_TIMEOUT_MS=10000
EMBEDDING_TOTAL_TIMEOUT_MS=30000

# Actual lowercase SHA256 from the GGUF file on BPLUTONIX; NOT configuration_hash.
# Operator checks the hashed file is the artifact currently served by llama.cpp.
EMBEDDING_ARTIFACT_SHA256=
