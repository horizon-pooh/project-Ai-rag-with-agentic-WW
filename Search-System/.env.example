# Application (private/local during development)
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
DATA_SOURCE=mock
SEARCH_DATABASE_URL=postgresql://search_api@127.0.0.1:15432/supabase_db_product
SEARCH_DATABASE_PASSWORD=
SEARCH_DATABASE_POOL_MAX=5

# Enable only after PostgreSQL setup. Generate a private token with npm run api:configure.
SEARCH_API_ENABLED=false
SEARCH_API_TOKEN=
# Optional local smoke-check target (never include credentials in the URL).
SEARCH_API_BASE_URL=http://127.0.0.1:3000
