# คัดลอกเป็น .env แล้วเติมค่า — ห้าม commit .env จริง
# ค่าที่มี (เสนอ) ยังไม่ได้ยืนยัน ดู docs/Line_ai_bot.md
# แบบใหม่: Python 3.12 + FastAPI + arq/Redis + Postgres + MinIO (อ่านที่ app/config.py ที่เดียว ขาดค่าบังคับ = ไม่เริ่ม)

# --- LINE (เก็บที่ระบบเราที่เดียว ห้ามส่งให้ AI API / ห้ามลง log) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- AI API ภายนอก ---
# รอคำตอบเรื่อง AI API
AI_API_URL=
# รอคำตอบเรื่อง AI API
AI_API_KEY=
# รอคำตอบเรื่อง AI API (ถ้าเป็น Softnix ตอบ 100-230 วิ)
AI_TIMEOUT_S=
# รอคำตอบเรื่อง AI API (ถ้าเป็น Softnix ทำได้ทีละงาน = 1)
AI_CONCURRENCY=
# (เสนอ) เพดานเวลารวมต่อข้อความ รวมทุกรอบที่ลองซ้ำ — รอคำตอบเรื่อง AI API
TURN_DEADLINE_S=

# --- ที่เก็บข้อมูล ---
DATABASE_URL=
# ใช้โดย service postgres ใน docker-compose.yml
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
# Redis เป็นคิวอย่างเดียว
REDIS_URL=redis://redis:6379
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
# (เสนอ) true ถ้า MinIO ใช้ https (ใน docker compose ใช้ http = false)
MINIO_SECURE=false
# ใช้โดย service minio ใน docker-compose.yml
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- state / ส่งต่อพนักงาน ---
STATE_TTL_HOURS=2
# นับจาก handoff_started_at
HANDOFF_TTL_HOURS=6
# (เสนอ) อายุ replyToken ที่เราเชื่อ (วินาที) เกินนี้ใช้ push — LINE ~1 นาที ต้องเช็คเอกสาร
REPLY_TOKEN_TTL_S=50
# (เสนอ) ถามกลับติดกันครบเท่านี้แล้วยังถามกลับ -> ส่งต่อพนักงาน
CLARIFY_MAX=2
# (เสนอ) ข้อความต่อนาทีต่อ user เกินนี้ = ถี่ผิดปกติ
RATE_LIMIT_PER_MIN=10
# (เสนอ) อายุลิงก์ /close (ชั่วโมง)
CLOSE_TOKEN_TTL_HOURS=24
# ใช้สร้างลิงก์ /close ใช้ครั้งเดียว — ต้องเป็น https://<DOMAIN>
PUBLIC_BASE_URL=

# --- HTTPS (Caddy) ---
# ใช้โดย service caddy ใน docker-compose.yml (Caddyfile) เช่น bot.example.com ไม่ต้องมี https://
# รอคำตอบ: ยังไม่ได้เลือกโดเมน
DOMAIN=

# --- แจ้ง call center (ช่องทางยังไม่ได้เลือก) ---
CALLCENTER_NOTIFY_CHANNEL=
CALLCENTER_NOTIFY_TARGET=
# (เติม) เวลาทำการ เช่น 09:00-18:00
CALLCENTER_HOURS=
# (เสนอ) timezone ของเวลาทำการ
TIMEZONE=Asia/Bangkok

# --- ทางหลบ ---
KILL_SWITCH=false

# --- log และแจ้งเตือน ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- ไฟล์กฎ ---
# (เสนอ) โฟลเดอร์ resume_ai.txt / escalate.txt / faq.txt
RULES_DIR=prompts/rules
