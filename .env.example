# คัดลอกเป็น .env แล้วเติมค่า — ห้าม commit .env จริง
# ค่าที่มี (เสนอ) ยังไม่ได้ยืนยัน ดู docs/decisions.md

NODE_ENV=production
PORT=3010

# --- LINE (เก็บที่ระบบเราที่เดียว ห้ามส่งให้ Softnix / ห้ามใส่ใน prompt) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- Softnix ---
SOFTNIX_API_URL=
SOFTNIX_API_KEY=
SOFTNIX_TIMEOUT_MS=180000
SOFTNIX_CONCURRENCY=1
# (เสนอ) คิวยาวเกินนี้ไม่รับเพิ่ม เสนอให้คุยกับเจ้าหน้าที่
SOFTNIX_MAX_QUEUE=5
# (เสนอ) รอเกินนี้เลิกรอ ส่งต่อคน — 5 นาที
SOFTNIX_HARD_LIMIT_MS=300000

# --- ที่เก็บข้อมูล ---
STORE=redis
REDIS_URL=redis://127.0.0.1:6379

# --- state / ปิดงาน ---
ESCALATION_TIMEOUT_MS=10800000
CLOSE_TOKEN_TTL_MS=86400000
PUBLIC_BASE_URL=

# --- แจ้ง call center (ช่องทางยังไม่ได้เลือก — docs/open-questions.md ข้อ 3) ---
CALLCENTER_NOTIFY_CHANNEL=
CALLCENTER_NOTIFY_TARGET=
# (เติม) เวลาทำการ เช่น 09:00-18:00
CALLCENTER_HOURS=

# --- ทางหลบ ---
KILL_SWITCH=false
