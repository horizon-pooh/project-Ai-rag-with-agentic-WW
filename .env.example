# คัดลอกเป็น .env แล้วเติมค่า — ห้าม commit .env จริง
# ค่าที่มี (เสนอ) ยังไม่ได้ยืนยัน ดู docs/Line_ai_bot.md
# แบบใหม่: Python 3.12 + FastAPI + procrastinate (คิวบน Postgres) + Postgres + MinIO (อ่านที่ app/config.py ที่เดียว ขาดค่าบังคับ = ไม่เริ่ม)

# --- LINE (เก็บที่ระบบเราที่เดียว ห้ามส่งให้ AI API / ห้ามลง log) ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# --- AI API ภายนอก (gateway แบบ OpenAI ที่ค้นสินค้าเอง — วัดจริง 2026-10-23 ดู docs/decisions.md D-011) ---
# ฐานของ API เช่น https://host/v1 (ไม่มี / ท้าย) — client เรียก POST {AI_API_URL}/chat/completions
# ว่าง = โหมดทดสอบ (StubAiClient ทวนข้อความกลับ ไม่เรียก AI จริง)
AI_API_URL=
# ส่งเป็น Authorization: Bearer <AI_API_KEY>
AI_API_KEY=
# ชื่อ model จาก GET {AI_API_URL}/models (ว่าง = gemma4-31b)
AI_MODEL=
# (ว่าง = 0.2 ค่าที่ใช้ตอนวัด)
AI_TEMPERATURE=
# markdown (ว่าง = ค่าตั้งต้น รูปแบบที่ API ตอบจริง) | json (สัญญาเสนอเดิมของเรา)
AI_RESPONSE_FORMAT=
# (ไม่บังคับ) ไฟล์ system prompt ที่ส่งนำหน้า — ว่าง = ไม่ส่ง (gateway มี prompt ของตัวเอง)
AI_SYSTEM_PROMPT_FILE=
# เวลาต่อหนึ่งครั้ง (ว่าง = 60) — วัดจริง: คำถามทั่วไป 2-7 วิ, ค้นสินค้า 22-43 วิ
AI_TIMEOUT_S=
# (เสนอ, ว่าง = 4) ยังไม่รู้ว่า gateway รับพร้อมกันได้กี่งาน — รอคำตอบ
AI_CONCURRENCY=
# เพดานเวลารวมต่อข้อความ รวมทุกรอบที่ลองซ้ำ (ว่าง = 90) — หนึ่งครั้งอาจถึง ~45 วิ เผื่อลองซ้ำหนึ่งครั้ง
TURN_DEADLINE_S=

# --- ที่เก็บข้อมูล ---
# ใช้ทั้ง app (psycopg) และ service migrate (dbmate) ใน docker compose -> ต้องเป็นรูปที่อ่านได้ทั้งคู่:
#   postgres://USER:PASS@postgres:5432/DB?sslmode=disable
# USER/PASS/DB ต้องตรงกับ POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB ข้างล่าง (host = ชื่อ service "postgres")
# คิวงาน (procrastinate) ก็อยู่ใน DB นี้ ไม่มี Redis
# รหัสผ่านที่มีอักขระพิเศษ (@ : / ? # %) ต้อง URL-encode ใน URL นี้; อย่าใช้ $ (docker compose แปลเป็นตัวแปร)
DATABASE_URL=
# ใช้โดย service postgres ใน docker-compose.yml
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=
# (เสนอ) true ถ้า MinIO ใช้ https (ใน docker compose ใช้ http = false)
MINIO_SECURE=false
# ใช้โดย service minio ใน docker-compose.yml
# MinIO ในเครื่อง (compose): MINIO_ACCESS_KEY ต้องเท่ากับ MINIO_ROOT_USER และ MINIO_SECRET_KEY เท่ากับ MINIO_ROOT_PASSWORD
# (MINIO_ROOT_PASSWORD อย่างน้อย 8 ตัวอักษร ไม่งั้น minio ไม่เริ่ม)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- state / ส่งต่อพนักงาน ---
STATE_TTL_HOURS=2
# นับจาก handoff_started_at
HANDOFF_TTL_HOURS=6
# (เสนอ) อายุ replyToken ที่เราเชื่อ (วินาที) เกินนี้ใช้ push — LINE ~1 นาที ต้องเช็คเอกสาร
REPLY_TOKEN_TTL_S=50
# (เสนอ) ถามกลับติดกันครบเท่านี้แล้วยังถามกลับ -> ส่งต่อพนักงาน
CLARIFY_MAX=2
# (เสนอ) ข้อความต่อนาทีต่อ user เกินนี้ = ถี่ผิดปกติ
RATE_LIMIT_PER_MIN=10
# (เสนอ) อายุลิงก์ /close (ชั่วโมง)
CLOSE_TOKEN_TTL_HOURS=24
# ใช้สร้างลิงก์ /close ใช้ครั้งเดียว — ต้องเป็น https://<DOMAIN>
PUBLIC_BASE_URL=

# --- HTTPS (Caddy) ---
# ใช้โดย service caddy ใน docker-compose.yml (Caddyfile) เช่น bot.example.com ไม่ต้องมี https://
# รอคำตอบ: ยังไม่ได้เลือกโดเมน
DOMAIN=

# --- retention (raw 90 วันตายตัวในโค้ด) ---
# (เสนอ) รูปเก็บสั้นกว่าข้อความ (วัน) เกินแล้วลบไฟล์ใน MinIO
IMAGE_RETENTION_DAYS=30
# ข้อความและ trace เกินนี้ (เดือน) -> anonymize
TRACE_RETENTION_MONTHS=12

# --- แจ้ง call center (ช่องทางยังไม่ได้เลือก) ---
CALLCENTER_NOTIFY_CHANNEL=
CALLCENTER_NOTIFY_TARGET=
# (เติม) เวลาทำการ เช่น 09:00-18:00
CALLCENTER_HOURS=
# (เสนอ) timezone ของเวลาทำการ
TIMEZONE=Asia/Bangkok

# --- ทางหลบ ---
KILL_SWITCH=false

# --- log และแจ้งเตือน ---
SENTRY_DSN=
LOG_LEVEL=INFO

# --- ไฟล์กฎ ---
# (เสนอ) โฟลเดอร์ resume_ai.txt / escalate.txt / faq.txt
RULES_DIR=prompts/rules
